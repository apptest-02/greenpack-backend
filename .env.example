# ── Greenpack Pro — Environment Configuration ─────────────────────────────────
# Copy to .env and fill in your values

# DEPLOYMENT MODE
GREENPACK_MODE=standalone
GREENPACK_VERSION=1.0.0
APP_NAME=Greenpack Pro
APP_SECRET_KEY=CHANGE_THIS_TO_64_CHAR_RANDOM_HEX

# DATABASE (Mode A: SQLite offline / Mode B: PostgreSQL)
DB_URL=sqlite+aiosqlite:///./data/greenpack.db
# DB_URL=postgresql+asyncpg://greenpack:STRONGPASS@localhost:5432/greenpackpro

# SERVER
API_HOST=127.0.0.1
API_PORT=18080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:18080,app://localhost

# JWT
JWT_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_64_CHAR_RANDOM_HEX
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# FILE STORAGE
STORAGE_TYPE=local
LOCAL_STORAGE_ROOT=./files
REPORTS_DIR=./reports
TEMPLATES_DIR=./templates
TEMP_DIR=./temp
BACKUP_DIR=./backups

# OCR ENGINE (Windows paths after install)
TESSERACT_PATH=C:/GreenpackPro/bin/tesseract/tesseract.exe
EASYOCR_MODEL_DIR=./models
EASYOCR_DOWNLOAD_ENABLED=false
OCR_TIMEOUT_SECONDS=120
OCR_MIN_CONFIDENCE=0.50

# INSPECTION DEFAULTS
DEFAULT_COLOR_TOLERANCE_DE=2.0
DEFAULT_SSIM_THRESHOLD=0.75
DEFAULT_SCAN_RESOLUTION_DPI=300
PDF_RASTER_DPI=300

# SCANNER
DWT_SERVICE_URL=http://127.0.0.1:18622
DWT_LICENSE_KEY=YOUR_DYNAMSOFT_LICENSE_KEY

# BACKUP & RETENTION
BACKUP_KEEP_DAYS=30
AUTO_BACKUP_ENABLED=true
REPORT_RETENTION_DAYS=90
SCAN_IMAGE_RETENTION_DAYS=30
DISK_SPACE_WARNING_GB=5
DISK_SPACE_CRITICAL_GB=2

# NOTIFICATIONS
TOAST_NOTIFICATIONS=true
EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=greenpackpro@yourfactory.com
NOTIFY_ON_FAIL_ONLY=true

# WEBHOOKS (ERP Integration)
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_RETRY_ATTEMPTS=3

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=./logs/engine.log
WINDOWS_EVENT_LOG=false

# LICENSE
LICENSE_SALT=GreenpackPro-AuraTech-2025-CHANGE-THIS
